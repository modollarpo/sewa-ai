{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api/v1",
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.sewaxai.health/api/v1",
        "EXPO_PUBLIC_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sewaxai.health/api/v1",
        "EXPO_PUBLIC_ENV": "production"
      }
    },
    "patient-preview": {
      "extends": "preview",
      "distribution": "internal",
      "ios": {
        "bundleIdentifier": "health.sewaxai.patient"
      },
      "android": {
        "applicationId": "health.sewaxai.patient"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.sewaxai.health/api/v1",
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_APP_ROLE": "patient"
      }
    },
    "patient-production": {
      "extends": "production",
      "autoIncrement": true,
      "ios": {
        "bundleIdentifier": "health.sewaxai.patient"
      },
      "android": {
        "applicationId": "health.sewaxai.patient"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sewaxai.health/api/v1",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_APP_ROLE": "patient"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "info@sewaxai.health",
        "ascAppId": "SEWA_AI_APP_ID",
        "appleTeamId": "APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "production"
      }
    }
  }
}
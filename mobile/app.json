{
  "expo": {
    "name": "SEWA XAI",
    "slug": "sewa-ai",
    "version": "2.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05100D"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/sewa-ai"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "health.sewaxai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Required for scanning QR codes and uploading scan images.",
        "NSMicrophoneUsageDescription": "Required for voice dictation in report editing.",
        "NSFaceIDUsageDescription": "Use Face ID for secure, fast authentication.",
        "NSPhotoLibraryUsageDescription": "Required to upload medical images for AI analysis.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05100D"
      },
      "package": "health.sewaxai.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@notifee/react-native"
      ],
      [
        "react-native-biometrics"
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          },
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "sewa-ai-project-id"
      },
      "apiUrl": "https://api.sewaxai.health/api/v1",
      "environment": "production",
      "sentryDsn": ""
    }
  }
}
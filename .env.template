# ── SEWA AI — Environment Template ──────────────────────────────
# Copy to .env and fill in values.
# DEPLOY_TARGET=local (docker-compose) | azure (AKS)
#
# For Azure: set DEPLOY_TARGET=azure then run:
#   cp backend/.env.azure backend/.env
# Or generate automatically: bash scripts/generate-env-azure.sh
# ─────────────────────────────────────────────────────────────────

DEPLOY_TARGET=local

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
REGION=uk
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sewa_ai?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# ── NHS CIS2 Authentication (production only) ──────────────────
# Set NHS_CIS2_ENABLED=true in production after registering with NHS Digital
NHS_CIS2_ENABLED=false
NHS_CIS2_ISSUER=https://auth.cis2.nhs.uk
NHS_CIS2_CLIENT_ID=
NHS_CIS2_CLIENT_SECRET=

# ── Research / Study Mode ──────────────────────────────────────
# Enable when running a clinical validation study (IRAS-approved)
RESEARCH_MODE_ENABLED=false
STUDY_ID=
BLIND_RADIOLOGIST=true

# ── Governance Contacts ────────────────────────────────────────
CALDICOTT_GUARDIAN_EMAIL=
DPO_EMAIL=dpo@sewaxai.health

# ── AI Services (local docker-compose ports) ───────────────────
TRIAGE_URL=http://localhost:8000
VLM_URL=http://localhost:8001
UNCERTAINTY_URL=http://localhost:8009
METACOGNITION_URL=http://localhost:8003
FL_SERVICE_URL=http://localhost:8004
CL_SERVICE_URL=http://localhost:8005
PATHOLOGY_SERVICE_URL=http://localhost:8002
MAMMOGRAPHY_SERVICE_URL=http://localhost:8007
RETINAL_SERVICE_URL=http://localhost:8008

# ── FHIR R4 ────────────────────────────────────────────────────
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TENANT_ID=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_VALIDATOR_URL=http://fhir-validator:8080

# ── NHS Terminology Service ────────────────────────────────────
NHS_TERMINOLOGY_URL=https://termcodes.nhs.uk/api
NHS_TERMINOLOGY_API_KEY=

# ── NHS PDS (Patient Demographic Service) ─────────────────────
NHS_PDS_URL=https://sandbox.api.service.nhs.uk/personal-demographics/FHIR/R4
NHS_PDS_API_KEY=

# ── HL7v2 ──────────────────────────────────────────────────────
HL7_HOST=localhost
HL7_PORT=2575
HL7_FACILITY=SEWA_AI_DEV

# ── PACS / DICOM ───────────────────────────────────────────────
PACS_HOST=localhost
PACS_PORT=104
PACS_AE_TITLE=SEWA_DEV

# ── Storage ────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=scans
AZURE_GRADCAM_CONTAINER=gradcam
AZURE_REPORTS_CONTAINER=reports
AZURE_STORAGE_ACCOUNT=

# ── Azure-specific (set DEPLOY_TARGET=azure to use these) ──────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_KEY_VAULT_URI=
AZURE_KEY_VAULT_NAME=
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_TRIAGE_QUEUE=sewa-scan-triage
AZURE_SERVICEBUS_HL7_QUEUE=sewa-hl7-messages
AZURE_SIGNALR_CONNECTION_STRING=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_CONFIDENTIAL_LEDGER_URL=
AKS_CLUSTER_NAME=
ACR_LOGIN_SERVER=

# ── Payments ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

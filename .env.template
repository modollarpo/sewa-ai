# ── Azure AI Speech ────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth

# ── Clinical Safety Thresholds ─────────────────────────────────
METACOGNITION_HALLUCINATION_THRESHOLD=0.30
UNCERTAINTY_ESCALATION_THRESHOLD=0.25

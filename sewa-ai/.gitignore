# SEWA AI — .gitignore
# ─────────────────────────────────────────────────────────────
# SECURITY CRITICAL: .env files contain production secrets
# Never commit these — use scripts/generate-env-azure.sh to rebuild

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.local
.env.azure
.env.production
.env.staging
backend/.env
backend/.env.*
!backend/.env.example

# ── Terraform secrets ─────────────────────────────────────────
infrastructure/terraform-azure/terraform.tfvars
infrastructure/terraform-aws/terraform.tfvars
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.terraform.lock.hcl

# ── Node.js ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.next/
out/
frontend/dist/
backend/dist/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
.pytest_cache/
*.pkl
*.pth          # PyTorch model weights — use Azure Blob / model registry

# ── AI Models (large binary files — use Azure Blob Storage) ───
*.onnx
*.bin
models/
model_cache/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker ────────────────────────────────────────────────────
.dockerignore

# ── Kubernetes rendered manifests (contain substituted secrets) ─
/tmp/deployment-rendered.yaml

# ── Azure ─────────────────────────────────────────────────────
.azure/
azureauth.json

# SEWA XAI Edge Node — Environment Template
# Copy to .env and populate before running: docker compose up -d
# NEVER commit .env with real credentials to git.
# © 2026 SEWA XAI — a Storegrill Inc Ltd company. Registered in England & Wales (14581073).

# ── Institution / Tenant ──────────────────────────────────────────────────
# Your SEWA XAI tenant ID (found in your admin dashboard)
TENANT_ID=your-tenant-uuid-here

# Your edge node API key (generated in Admin > Edge Nodes)
EDGE_API_KEY=edge_key_xxxx

# Unique name for this physical node (useful if hospital has multiple)
EDGE_NODE_ID=lagos-general-edge-01

# ── Cloud Sync ────────────────────────────────────────────────────────────
# Production SEWA XAI API
CLOUD_API_URL=https://api.sewaxai.health

# How often to push unsynced results to cloud (in seconds)
# 300 = every 5 minutes (default)
# 60  = every 1 minute (high connectivity sites)
# 3600 = every hour (very low bandwidth/intermittent GSM)
SYNC_INTERVAL_SECS=300

# ── Volume paths on host machine ─────────────────────────────────────────
EDGE_DATA_PATH=./data
EDGE_MODELS_PATH=./models
EDGE_LOGS_PATH=./logs

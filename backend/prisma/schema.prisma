// SEWA XAI — Prisma Schema
// PostgreSQL 15+ | Multi-tenant schema isolation
// README.pdf: Feature 1 (Multi-Tenant), Feature 2 (Auth), Feature 3 (AI), Feature 4 (FHIR/HL7)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS — type-safe RBAC and status fields ──────────────────
// Using String fields with comments for now; enums available for migration
// to Prisma enum when ready: prevents typos like "Radioloist" vs "Radiologist"
// enum UserRole { superadmin admin radiologist doctor technician patient }
// enum ScanStatus { pending processing ai_complete reported approved rejected failed }
// enum ScanPriority { STAT URGENT ROUTINE }
// enum ReferralPriority { STAT URGENT ROUTINE }

// ── TENANTS (Hospitals / Clinics) ─────────────────────────────
model Tenant {
  id                 String  @id @default(uuid())
  name               String
  slug               String  @unique
  subdomain          String  @unique
  region             String // uk | eu | us | ng | ke | za | gh | in
  currency           String // GBP | EUR | USD | NGN | KES | ZAR | GHS | INR
  language           String  @default("en")
  plan               String  @default("starter") // starter | pro | enterprise
  status             String  @default("active") // active | suspended | trial
  fhirBaseUrl        String?
  hl7Endpoint        String?
  pacsEndpoint       String?
  stripeCustomerId   String?
  paystackCustomerId String?
  latitude           Float?
  longitude          Float?
  timezone           String  @default("UTC")
  address            String?
  providerMetadata   Json? // { mpesa: { shortcode, passkey }, flutterwave: { publicKey }, region-specific config }
  apiKey             String? @unique @default(uuid())
  supportedModalities String[] @default(["CT", "XRAY"])

  // ── Billing & Quota ─────────────────────────────────────────
  subscriptionId      String? // Stripe subscription ID / Paystack subscription code
  subscriptionStatus  String?   @default("trial") // trial | active | past_due | cancelled | suspended
  whatsappEnabled     Boolean   @default(false)
  smsEnabled          Boolean   @default(false)
  primaryContactEmail String?
  scanQuota           Int? // monthly scan limit (null = unlimited for enterprise)
  scansUsedThisMonth  Int       @default(0)
  billingCycleResetAt DateTime? // when monthly quota resets
  trialEndsAt         DateTime? // when free trial expires
  nextBillDate        DateTime?
  billingEmail        String?
  reportLanguage      String?   @default("en") // default report language for this tenant
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users                   User[]
  scans                   Scan[]
  reports                 Report[]
  payments                Payment[]
  auditLogs               AuditLog[]
  aiModels                TenantAIModel[]
  templates               ReportTemplate[]
  appointments            Appointment[]
  whatsappRegs            WhatsAppRegistration[]
  notificationLogs        NotificationLog[]
  dicomNodes              DicomNode[]
  complianceRecords       ComplianceRecord[]
  dunningLogs             DunningLog[]
  supportTickets          SupportTicket[]
  modelPerformanceMetrics ModelPerformanceMetric[]
  aiDriftEvents           AIDriftEvent[]
  customerFeedbacks       CustomerFeedback[]
  federatedNodes          FederatedNode[]
  edgeDevices             EdgeDevice[]

  @@index([region])
  @@index([status])
}

// ── USERS ──────────────────────────────────────────────────────
model User {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  email            String
  passwordHash     String
  firstName        String
  lastName         String
  role             String // superadmin | admin | radiologist | doctor | technician | patient
  speciality       String? // radiology | neurology | cardiology | etc
  licenseNumber    String?
  phone            String?
  language         String    @default("en")
  timezone         String    @default("UTC")
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  biometricKey     String?
  status           String    @default("active")
  inviteToken      String?   @unique
  lastLoginAt      DateTime?
  // Stripe Connect for Specialists (90/10 revenue split)
  stripeAccountId  String?
  // Notifications & WhatsApp
  fcmTokens        String[]  @default([])
  whatsappNumber   String?
  whatsappVerified Boolean   @default(false)
  notifPrefs       Json? // { push:bool, email:bool, whatsapp:bool, sms:bool }
  consentPrefs     Json? // { ai:bool, federated:bool, research:bool }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions            Session[]
  scansReferred       Scan[]               @relation("ReferringDoctor")
  reports             Report[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  secondRequester     SecondOpinion[]      @relation("Requester")
  secondAssigned      SecondOpinion[]      @relation("AssignedSpecialist")
  clinicalValidations ClinicalValidation[]
  notificationLogs    NotificationLog[]
  patientRecord       Patient?
  supportTickets      SupportTicket[]
  customerFeedbacks   CustomerFeedback[]

  @@unique([tenantId, email])
  @@index([role])
  @@index([tenantId])
}

// ── SESSIONS ───────────────────────────────────────────────────
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ── PATIENTS ───────────────────────────────────────────────────
model Patient {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  tenantId          String
  mrn               String // Medical Record Number
  dateOfBirth       DateTime
  sex               String // M | F | O
  bloodType         String?
  allergies         String[]
  conditions        String[]
  nhsNumber         String? // National Health Service Number (UK specific)
  nghiaNumber       String? // NHIA Number (Ghana specific)
  nhifNumber        String? // NHIF Number (Kenya specific)
  ninNumber         String? // National Identification Number (Nigeria specific)
  universalHealthId String? // Universal Health ID (cross-jurisdiction)
  fhirId            String? // FHIR Patient resource ID
  consentAI         Boolean   @default(true)
  consentResearch   Boolean   @default(false)
  consentThirdParty Boolean   @default(false)
  deletedAt         DateTime? // soft delete — never hard-delete patient records (clinical record continuity)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scans       Scan[]
  messages    Message[]
  Appointment Appointment[]

  @@unique([tenantId, mrn])
  @@index([tenantId])
}

// ── SCANS ──────────────────────────────────────────────────────
model Scan {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id])
  referringDoctorId String?
  referringDoctor   User?    @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])

  modality        String // CT | MRI | XR | US | PET | PETCT
  bodyPart        String // Head | Chest | Abdomen | Pelvis | Spine | etc
  priority        String // STAT | URGENT | ROUTINE
  status          String  @default("pending") // pending | processing | ai_complete | reported | approved | rejected | failed
  errorMessage    String? // populated when status = 'failed' — DICOM corrupt, AI service down, etc.
  accessionNumber String? @unique // Hospital-provided identifier for the scan
  origin          String  @default("cloud") // cloud | edge

  // DICOM
  dicomInstanceUid String?
  dicomStudyUid    String?
  dicomSeriesUid   String?
  pacsUrl          String?
  storageUrl       String? // Azure Blob / S3 URL
  fileName         String? // original filename
  fileSize         Int? // bytes

  // Clinical
  clinicalIndication String?
  technique          String?

  // FHIR
  fhirImagingStudyId String?
  hl7OrderId         String?

  // Scheduling
  scheduledAt DateTime?
  acquiredAt  DateTime?
  receivedAt  DateTime  @default(now())
  deletedAt   DateTime? // soft delete — clinical records never hard-deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // AI Triage result
  urgency String? // CRITICAL | URGENT | NORMAL | ROUTINE — set after AI completes

  // Human review flags (set by metacognition or uncertainty engine)
  requiresHumanReview Boolean @default(false)
  humanReviewReason   String? // METACOGNITION_FAIL | HIGH_UNCERTAINTY | MANUAL

  aiResult                AIResult?
  report                  Report?
  annotations             Annotation[]
  secondOpinions          SecondOpinion[]
  clinicalValidation      ClinicalValidation?
  modelPerformanceMetrics ModelPerformanceMetric[]

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([patientId])
  @@index([urgency])
  @@index([requiresHumanReview])
}

// ── AI RESULTS (Triage Engine output) ────────────────────────
model AIResult {
  id       String  @id @default(uuid())
  scanId   String  @unique
  scan     Scan    @relation(fields: [scanId], references: [id])
  tenantId String?

  // Triage Engine
  primaryFinding String
  urgency        String // CRITICAL | URGENT | NORMAL
  confidence     Float // 0.0–1.0
  location       String?
  size           String?
  midlineShift   String?
  summary        String?

  // Uncertainty Engine (Feature 3)
  uncertaintyScore     Float?
  epistemicUncertainty Float? // Model uncertainty (reducible with more data)
  aleatoricUncertainty Float? // Data noise (image quality issues)
  metacognitionFlags   String[] // NO_FINDING | AMBIGUOUS | NOISE_DETECTED
  gradcamUrl           String? // Grad-CAM heatmap stored in blob
  shapValues           Json? // SHAP feature importance array

  // VLM Report (Feature 3 — pre-filled into report editor)
  vlmTechnique  String?
  vlmFindings   String?
  vlmImpression String?
  vlmFullText   String?

  // Metacognition Engine (INDUSTRIALIZED)
  metacognitionPassed Boolean @default(false)
  metacognitionLayers Json? // Full 9-layer results as JSON
  hallucinationRisk   Float?
  selfEvalNotes       String?
  icd10Codes          String? // Feature 17: Billing/Coding integration

  // Raw Output & Metadata
  rawJson             Json? // Full inference payload from AI provider
  modelId             String?
  modelVersion        String?
  inferenceMs         Int? // latency
  clinicalContext     String? // FHIR context used for multimodal inference
  longitudinalContext String? // Prior scan comparison context

  // Validation (Feature 3/4)
  validationStatus      String? // CONFIRMED | REJECTED | AMBIGUOUS
  humanCorrectedFinding String? // Correction from a human specialist
  validationComments    String? // Notes from the validator
  validatedBy           String? // User ID of the validator
  validatedAt           DateTime? // When it was validated

  // A/B test tracking (Feature 7)
  abTestGroup String?
  abModelId   String?

  // Clinical performance tracking
  isFalsePositive Boolean?
  isFalseNegative Boolean?
  fROCPoint       Float? // Calibration point on Free-response ROC
  calibrationId   String? // link to calibration cohort

  createdAt DateTime @default(now())

  @@index([urgency])
  @@index([scanId])
}

// ── REPORTS ───────────────────────────────────────────────────
model Report {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  scanId     String          @unique
  scan       Scan            @relation(fields: [scanId], references: [id])
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  templateId String?
  template   ReportTemplate? @relation(fields: [templateId], references: [id])

  // Content
  technique      String?
  findings       String
  impression     String
  recommendation String?
  fullText       String? // full structured report
  content        String? // legacy content field
  summary        String? // legacy summary field

  // Status
  status   String    @default("draft") // draft | pending_review | approved | rejected | signed
  signedAt DateTime?
  signedBy String?

  // VLM generation metadata (Feature 3)
  vlmGenerated  Boolean @default(false)
  vlmVersion    String?
  vlmPrompt     String?
  editedByHuman Boolean @default(false)

  // FHIR output
  fhirDiagnosticReportId String?
  hl7OruMessageId        String?

  // Blockchain audit (Feature 19)
  blockchainHash String?
  blockchainTxId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pdfUrl String? // URL to the generated clinical PDF/HTML report

  secondOpinions SecondOpinion[]

  @@index([tenantId])
  @@index([status])
  @@index([authorId])
}

// ── ACI FEEDBACK (Ambient Clinical Intelligence loop) ────────
model ACIFeedback {
  id            String   @id @default(uuid())
  scanId        String
  userId        String
  tenantId      String
  
  originalText  String   @db.Text
  correctedText String   @db.Text
  source        String   // e.g. VOICE_DICTATION, VLM_PREFILL
  
  createdAt     DateTime @default(now())

  @@index([scanId])
  @@index([tenantId])
}

// ── REPORT TEMPLATES (Feature 11) ─────────────────────────────
model ReportTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  specialty String // radiology | neuro | cardio | msk | etc
  modality  String?
  bodyPart  String?
  structure Json // template sections with placeholders
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@index([tenantId, specialty])
}

// ── IMAGE ANNOTATIONS (Feature 12) ────────────────────────────
model Annotation {
  id        String   @id @default(uuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id])
  userId    String
  type      String // rectangle | ellipse | polygon | freehand | arrow
  data      Json // coordinates, measurements
  label     String?
  color     String   @default("#FFD700")
  createdAt DateTime @default(now())

  @@index([scanId])
}

// ── SECOND OPINIONS (Feature 13) ──────────────────────────────
model SecondOpinion {
  id           String   @id @default(uuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id])
  reportId     String?
  report       Report?  @relation(fields: [reportId], references: [id])
  requesterId  String
  requester    User     @relation("Requester", fields: [requesterId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("AssignedSpecialist", fields: [assignedToId], references: [id])
  status       String   @default("pending") // pending | assigned | completed | disagreement | cancelled
  priority     String   @default("ROUTINE") // STAT | URGENT | ROUTINE
  reason       String?  @db.Text
  notes        String?  @db.Text
  reviewNotes  String?  @db.Text
  agreedWithAI Boolean?

  // SLA & Workflow
  slaDeadline DateTime?
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scanId])
  @@index([status])
  @@index([priority])
  @@index([requesterId])
  @@index([assignedToId])
}

// ── NOTIFICATIONS (Feature 6) ─────────────────────────────────
model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String // critical_finding | report_ready | second_opinion | payment | system
  title      String
  message    String
  body       String
  data       Json?
  read       Boolean  @default(false)
  fcmSent    Boolean  @default(false)
  tenantId   String
  scanId     String?
  aiResultId String?
  channels   String[] @default([])
  createdAt  DateTime @default(now())

  @@index([userId, read])
}

// ── PAYMENTS (Feature 5) ──────────────────────────────────────
model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  type       String // subscription | per_scan | one_time
  provider   String // stripe | paystack | flutterwave | mpesa
  externalId String? // Stripe PaymentIntent ID, Paystack reference, etc
  amount     Float
  currency   String
  status     String // pending | succeeded | failed | refunded
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([provider])
}

// ── AI MODEL REGISTRY (Feature 7, 18) ─────────────────────────
model AIModel {
  id         String   @id @default(uuid())
  name       String
  version    String
  type       String // triage | uncertainty | metacognition | vlm
  status     String   @default("production") // production | ab_test | training | deprecated
  accuracy   Float?
  trafficPct Float    @default(100) // % of traffic for A/B testing
  conditions String[] // conditions it detects
  modelPath  String? // path in Azure ML / S3
  isGlobal   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenantModels TenantAIModel[]
}

model TenantAIModel {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  modelId    String
  model      AIModel  @relation(fields: [modelId], references: [id])
  trafficPct Float    @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([tenantId, modelId])
}

// ── AUDIT LOG — HIPAA/GDPR Compliant (Feature 19) ────────────
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String // LOGIN | LOGOUT | SCAN_UPLOAD | REPORT_SIGNED | etc
  entity       String? // Scan | AIResult | Report | Notification | User
  entityId     String?
  previousHash String? // SHA-256 of previous audit record (Merkle chain)
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  // Blockchain (Feature 19)
  sha256Hash   String?
  blockIndex   Int?
  merkleRoot   String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityId])
  @@index([createdAt])
}

// ── MESSAGES (Feature 8 — Patient Portal) ────────────────────
model Message {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  fromUserId String?
  fromRole   String // doctor | radiologist | system | patient
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([patientId])
}

// ── USER NOTIFICATION & WHATSAPP FIELDS (migration adds to User) ─
// Add these fields to the User model above via migration:
// whatsappNumber    String?
// whatsappVerified  Boolean  @default(false)
// fcmTokens         String[] @default([])
// notifPrefs        Json?    // { push:bool, email:bool, whatsapp:bool, sms:bool }

// ── APPOINTMENTS ──────────────────────────────────────────────
model Appointment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String
  // doctor     User      (resolved via userId lookup — no Prisma relation to avoid multi-relation)

  scanId   String? // optional — pre-scan appointment
  reportId String? // optional — post-report follow-up

  type     String // consultation | follow_up | imaging | telemedicine | second_opinion
  status   String @default("scheduled") // scheduled | confirmed | cancelled | completed | no_show | rescheduled
  priority String @default("routine") // routine | urgent | stat

  scheduledDate DateTime
  durationMins  Int      @default(30)
  location      String? // room / video URL
  notes         String?
  cancelReason  String?
  cancelledById String?

  // Reminders
  reminderSent24h Boolean @default(false)
  reminderSent1h  Boolean @default(false)

  // Telehealth
  videoUrl    String?
  videoRoomId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledDate])
  @@index([status])
}

// ── NOTIFICATION PREFERENCES ──────────────────────────────────
model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  // Channels
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  // Per-event overrides stored as JSON: { "critical_finding": { push:true, email:true } }
  eventOverrides  Json?
  // Quiet hours (UTC)
  quietStart      String? // "22:00"
  quietEnd        String? // "07:00"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── WHATSAPP REGISTRATIONS ─────────────────────────────────────
model WhatsAppRegistration {
  id           String    @id @default(uuid())
  userId       String    @unique
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  number       String // E.164 e.g. +447911123456
  verified     Boolean   @default(false)
  verifyCode   String?
  verifyExpiry DateTime?
  optedIn      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([number])
}

// ── NOTIFICATION LOG (delivery tracking) ──────────────────────
model NotificationLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  channel   String // push | email | whatsapp | socket
  status    String // sent | failed | bounced | delivered
  metadata  Json? // FCM message ID, email message ID, WhatsApp SID
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([channel, status])
}

// ── CLINICAL VALIDATION (Feature 13) ──────────────────────────
model ClinicalValidation {
  id            String   @id @default(uuid())
  scanId        String   @unique
  scan          Scan     @relation(fields: [scanId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("pending") // pending | agreed | disagreed | uncertain
  aiConfidence  Float
  humanNotes    String?
  findingsMatch Boolean?
  createdAt     DateTime @default(now())

  @@index([scanId])
  @@index([status])
}

// ── DICOM NODES & CONNECTIVITY (Feature 4) ────────────────────
model DicomNode {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  aeTitle   String
  ipAddress String
  port      Int      @default(11112)
  status    String   @default("online")
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ── REGULATORY AUDIT & COMPLIANCE (Feature 19) ────────────────
model ComplianceRecord {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  standard     String // GDPR | HIPAA | NHS_DSPT | CE_MARK | FDA_510K
  status       String // compliant | gap_detected | in_remediation
  evidenceUrls String[]
  lastAuditAt  DateTime @default(now())
  nextAuditAt  DateTime
  createdAt    DateTime @default(now())

  @@index([tenantId, standard])
}

// ── DUNNING LOG (Failed Payment Recovery) ─────────────────────
model DunningLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  step      Int // 1, 2, 3 — which dunning step this is
  sentAt    DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([step])
}

// ── SUPPORT TICKETS (Customer Support Integration) ────────────────────
model SupportTicket {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  description String
  category    String // billing | technical | clinical | general | feature_request
  priority    String // low | medium | high | urgent
  status      String   @default("open") // open | in_progress | waiting_on_customer | resolved | closed
  zendeskId   String? // External ticket ID if using Zendesk
  assignedTo  String? // User ID of support agent assigned
  tags        String[]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ── MODEL PERFORMANCE MONITORING (Post-Market Surveillance) ────────────
model AIModelVersion {
  id                      String                   @id @default(uuid())
  modelType               String // triage | uncertainty | vlm | metacognition
  version                 String // e.g., "2.4.1"
  description             String? // release notes/what changed
  region                  String? // uk | eu | us | africa | india
  active                  Boolean                  @default(true)
  deployedAt              DateTime                 @default(now())
  metadata                Json? // model weights hash, hyperparams, etc.
  modelPerformanceMetrics ModelPerformanceMetric[]
  aiDriftEvents           AIDriftEvent[]

  @@index([modelType])
  @@index([region])
  @@index([active])
}

model ModelPerformanceMetric {
  id             String         @id @default(uuid())
  modelVersionId String
  modelVersion   AIModelVersion @relation(fields: [modelVersionId], references: [id])
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  scanId         String?
  scan           Scan?          @relation(fields: [scanId], references: [id])
  modality       String
  condition      String?
  metricType     String // accuracy | precision | recall | specificity | f1 | auroc | kappa | psi // psi=population stability index (drift)
  value          Decimal
  sampleSize     Int?
  windowStart    DateTime?
  windowEnd      DateTime?
  createdAt      DateTime       @default(now())

  @@index([modelVersionId])
  @@index([tenantId])
  @@index([modality])
  @@index([createdAt])
}

model AIDriftEvent {
  id             String         @id @default(uuid())
  modelVersionId String
  modelVersion   AIModelVersion @relation(fields: [modelVersionId], references: [id])
  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  driftType      String // data | concept | prediction
  severity       String // low | medium | high | critical
  description    String
  detectedAt     DateTime       @default(now())
  resolvedAt     DateTime?
  status         String         @default("detected") // detected | investigating | mitigated | resolved
  metadata       Json?

  @@index([modelVersionId])
  @@index([tenantId])
  @@index([status])
}

// ── CUSTOMER FEEDBACK LOOP ───────────────────────────────────────────
model CustomerFeedback {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  feedbackType String // feature_request | bug_report | satisfaction | usability | general
  score        Int? // 1-5 for satisfaction ratings
  subject      String?
  description  String
  category     String? // e.g., "radiologist_ui", "ai_accuracy", "mobile_app"
  metadata     Json? // associated scanId, reportId, etc.
  status       String   @default("new") // new | reviewed | in_progress | actioned | closed
  prioritized  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, id], name: "tenantId_id")
  @@index([tenantId])
  @@index([userId])
  @@index([feedbackType])
  @@index([status])
  @@index([createdAt])
}

// ── FEDERATED LEARNING ───────────────────────────────────────────────
model FederatedNode {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  status                String   @default("active") // active | offline | syncing
  totalScansContributed Int      @default(0)
  computeCapacity       String   @default("medium") // low | medium | high
  lastSyncAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model FederatedRound {
  id                 String   @id @default(uuid())
  roundNumber        Int      @unique
  status             String   @default("in_progress") // pending | in_progress | completed | failed
  participatingNodes Int      @default(0)
  totalDataVolume    Int      @default(0) // total scans used in this round
  epochLoss          Float?
  accuracy           Float?
  aggregatedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
}

// ── EDGE AI (OFFLINE SYNC) ─────────────────────────────────────────
model EdgeDevice {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  deviceId        String   @unique // Hardware serial or MAC
  deviceName      String   @default("Mobile Clinic Tablet")
  status          String   @default("offline") // online | offline | syncing
  lastHeartbeat   DateTime @default(now())
  storageUsedMB   Int      @default(0)
  totalSyncedScans Int     @default(0)
  region          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncLogs        EdgeSyncLog[]

  @@index([tenantId])
  @@index([status])
}

model EdgeSyncLog {
  id               String      @id @default(uuid())
  edgeDeviceId     String
  edgeDevice       EdgeDevice  @relation(fields: [edgeDeviceId], references: [id])
  scansUploaded    Int         @default(0)
  bytesTransferred Int         @default(0)
  syncDurationSec  Int         @default(0)
  status           String      @default("success") // success | failed | partial
  createdAt        DateTime    @default(now())

  @@index([edgeDeviceId])
}

// ── POPULATION HEALTH & EPIDEMIOLOGY ────────────────────────────────
model EpidemiologyEvent {
  id              String   @id @default(uuid())
  disease         String   // e.g., Tuberculosis, Pneumonia, ICH, Stroke
  region          String   // e.g., UK, NG, KE
  subRegion       String?  // e.g., Lagos, Nairobi, London
  severity        String   // High, Medium, Low
  confidenceScore Float    // AI confidence
  scanOrigin      String   @default("cloud") // edge vs cloud
  detectedAt      DateTime @default(now())

  @@index([disease, region])
  @@index([detectedAt])
}

// SEWA XAI — Prisma Schema
// PostgreSQL 15+ | Multi-tenant schema isolation
// README.pdf: Feature 1 (Multi-Tenant), Feature 2 (Auth), Feature 3 (AI), Feature 4 (FHIR/HL7)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS — type-safe RBAC and status fields ──────────────────
// Using String fields with comments for now; enums available for migration
// to Prisma enum when ready: prevents typos like "Radioloist" vs "Radiologist"
// enum UserRole { superadmin admin radiologist doctor technician patient }
// enum ScanStatus { pending processing ai_complete reported approved rejected failed }
// enum ScanPriority { STAT URGENT ROUTINE }
// enum ReferralPriority { STAT URGENT ROUTINE }

// ── TENANTS (Hospitals / Clinics) ─────────────────────────────
model Tenant {
  id                 String  @id @default(uuid())
  name               String
  slug               String  @unique
  subdomain          String  @unique
  region             String // uk | eu | us | ng | ke | za | gh | in
  currency           String // GBP | EUR | USD | NGN | KES | ZAR | GHS | INR
  language           String  @default("en")
  plan               String  @default("starter") // starter | pro | enterprise
  status             String  @default("active") // active | suspended | trial
  fhirBaseUrl        String?
  hl7Endpoint        String?
  pacsEndpoint       String?
  stripeCustomerId   String?
  paystackCustomerId String?
  stripeAccountId    String?
  latitude           Float?
  longitude          Float?
  timezone           String  @default("UTC")
  address            String?
  providerMetadata   Json? // { mpesa: { shortcode, passkey }, flutterwave: { publicKey }, region-specific config }
  apiKey             String? @unique @default(uuid())
  supportedModalities String[] @default(["CT", "XRAY"])

  // ── Billing & Quota ─────────────────────────────────────────
  subscriptionId      String? // Stripe subscription ID / Paystack subscription code
  subscriptionStatus  String?   @default("trial") // trial | active | past_due | cancelled | suspended
  whatsappEnabled     Boolean   @default(false)
  smsEnabled          Boolean   @default(false)
  primaryContactEmail String?
  scanQuota           Int? // monthly scan limit (null = unlimited for enterprise)
  scansUsedThisMonth  Int       @default(0)
  billingCycleResetAt DateTime? // when monthly quota resets
  trialEndsAt         DateTime? // when free trial expires
  nextBillDate        DateTime?
  billingEmail        String?
  reportLanguage      String?   @default("en") // default report language for this tenant
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users                   User[]
  scans                   Scan[]
  reports                 Report[]
  payments                Payment[]
  auditLogs               AuditLog[]
  aiModels                TenantAIModel[]
  templates               ReportTemplate[]
  appointments            Appointment[]
  whatsappRegs            WhatsAppRegistration[]
  notificationLogs        NotificationLog[]
  dicomNodes              DicomNode[]
  complianceRecords       ComplianceRecord[]
  dunningLogs             DunningLog[]
  supportTickets          SupportTicket[]
  modelPerformanceMetrics ModelPerformanceMetric[]
  aiDriftEvents           AIDriftEvent[]
  customerFeedbacks       CustomerFeedback[]
  federatedNodes          FederatedNode[]
  edgeDevices             EdgeDevice[]
  edgeSites               EdgeSite[]
  longitudinalRecords     LongitudinalRecord[]

  @@index([region])
  @@index([status])
}

// ── USERS ──────────────────────────────────────────────────────
model User {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  email            String
  passwordHash     String
  firstName        String
  lastName         String
  role             String // superadmin | admin | radiologist | doctor | technician | patient
  speciality       String? // radiology | neurology | cardiology | etc
  licenseNumber    String?
  phone            String?
  language         String    @default("en")
  timezone         String    @default("UTC")
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  biometricKey     String?
  status           String    @default("active")
  inviteToken      String?   @unique
  lastLoginAt      DateTime?
  // Stripe Connect for Specialists (90/10 revenue split)
  stripeAccountId  String?
  // Notifications & WhatsApp
  fcmTokens        String[]  @default([])
  whatsappNumber   String?
  whatsappVerified Boolean   @default(false)
  notifPrefs       Json? // { push:bool, email:bool, whatsapp:bool, sms:bool }
  consentPrefs     Json? // { ai:bool, federated:bool, research:bool }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions            Session[]
  scansReferred       Scan[]               @relation("ReferringDoctor")
  reports             Report[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  secondRequester     SecondOpinion[]      @relation("Requester")
  secondAssigned      SecondOpinion[]      @relation("AssignedSpecialist")
  clinicalValidations ClinicalValidation[]
  notificationLogs    NotificationLog[]
  patientRecord       Patient?
  supportTickets      SupportTicket[]
  customerFeedbacks   CustomerFeedback[]

  @@unique([tenantId, email])
  @@index([role])
  @@index([tenantId])
}

// ── SESSIONS ───────────────────────────────────────────────────
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ── PATIENTS ───────────────────────────────────────────────────
model Patient {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  tenantId          String
  mrn               String // Medical Record Number
  dateOfBirth       DateTime
  sex               String // M | F | O
  bloodType         String?
  allergies         String[]
  conditions        String[]
  nhsNumber         String? // National Health Service Number (UK specific)
  nghiaNumber       String? // NHIA Number (Ghana specific)
  nhifNumber        String? // NHIF Number (Kenya specific)
  ninNumber         String? // National Identification Number (Nigeria specific)
  universalHealthId String? // Universal Health ID (cross-jurisdiction)
  fhirId            String? // FHIR Patient resource ID
  consentAI         Boolean   @default(true)
  consentResearch   Boolean   @default(false)
  consentThirdParty Boolean   @default(false)
  deletedAt         DateTime? // soft delete — never hard-delete patient records (clinical record continuity)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scans       Scan[]
  messages    Message[]
  Appointment Appointment[]
  longitudinalRecords LongitudinalRecord[]

  @@unique([tenantId, mrn])
  @@index([tenantId])
}

// ── SCANS ──────────────────────────────────────────────────────
model Scan {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id])
  referringDoctorId String?
  referringDoctor   User?    @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])

  modality        String // CT | MRI | XR | US | PET | PETCT
  bodyPart        String // Head | Chest | Abdomen | Pelvis | Spine | etc
  priority        String // STAT | URGENT | ROUTINE
  status          String  @default("pending") // pending | processing | ai_complete | reported | approved | rejected | failed
  errorMessage    String? // populated when status = 'failed' — DICOM corrupt, AI service down, etc.
  accessionNumber String? @unique // Hospital-provided identifier for the scan
  origin          String  @default("cloud") // cloud | edge

  // DICOM
  dicomInstanceUid String?
  dicomStudyUid    String?
  dicomSeriesUid   String?
  pacsUrl          String?
  storageUrl       String? // Azure Blob / S3 URL
  fileName         String? // original filename
  fileSize         Int? // bytes

  // Clinical
  clinicalIndication String?
  technique          String?

  // FHIR
  fhirImagingStudyId String?
  hl7OrderId         String?

  // Scheduling
  scheduledAt DateTime?
  acquiredAt  DateTime?
  receivedAt  DateTime  @default(now())
  deletedAt   DateTime? // soft delete — clinical records never hard-deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // AI Triage result
  urgency String? // CRITICAL | URGENT | NORMAL | ROUTINE — set after AI completes

  // Human review flags (set by metacognition or uncertainty engine)
  requiresHumanReview Boolean @default(false)
  humanReviewReason   String? // METACOGNITION_FAIL | HIGH_UNCERTAINTY | MANUAL

  // Pipeline orchestration (Phase 1 of architectural redesign)
  pipelineStage      String?  // preprocessing | triage_uncertainty | vlm | metacognition | human_review | complete | failed
  pipelineStartedAt  DateTime? // set when scan enters the AI pipeline
  pipelineCompletedAt DateTime? // set when pipeline reaches terminal state
  pipelineMetadata   Json?    // { stageTimings: { triage: 320, vlm: 28, metacog: 15 }, qualityFlags: [], retryCount: 0 }

  // Image quality assessment (preprocessing stage)
  qualityScore  Float?  // 0-1 image quality score (motion, noise, positioning)
  qualityFlags  String[] // MOTION_ARTIFACT | NOISE | LOW_DOSE | POOR_POSITIONING | OUT_OF_FIELD

  aiResult                AIResult?
  report                  Report?
  annotations             Annotation[]
  secondOpinions          SecondOpinion[]
  clinicalValidation      ClinicalValidation?
  modelPerformanceMetrics ModelPerformanceMetric[]
  longitudinalRecords     LongitudinalRecord[]
  edgePreProcessing       EdgePreProcessing?

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([patientId])
  @@index([urgency])
  @@index([requiresHumanReview])
  @@index([pipelineStage])
}

// ── AI RESULTS (Triage Engine output) ────────────────────────
model AIResult {
  id       String  @id @default(uuid())
  scanId   String  @unique
  scan     Scan    @relation(fields: [scanId], references: [id])
  tenantId String?

  // Triage Engine
  primaryFinding String
  urgency        String // CRITICAL | URGENT | NORMAL
  confidence     Float // 0.0–1.0
  location       String?
  size           String?
  midlineShift   String?
  summary        String?

  // Uncertainty Engine (Feature 3)
  uncertaintyScore     Float?
  epistemicUncertainty Float? // Model uncertainty (reducible with more data)
  aleatoricUncertainty Float? // Data noise (image quality issues)
  metacognitionFlags   String[] // NO_FINDING | AMBIGUOUS | NOISE_DETECTED
  gradcamUrl           String? // Grad-CAM heatmap stored in blob
  shapValues           Json? // SHAP feature importance array

  // VLM Report (Feature 3 — pre-filled into report editor)
  vlmTechnique  String?
  vlmFindings   String?
  vlmImpression String?
  vlmFullText   String?

  // Metacognition Engine (INDUSTRIALIZED)
  metacognitionPassed Boolean @default(false)
  metacognitionLayers Json? // Full 9-layer results as JSON
  hallucinationRisk   Float?
  selfEvalNotes       String?
  icd10Codes          String? // Feature 17: Billing/Coding integration
  metacognitionScore  Float?  // 0-1 composite metacognition quality score

  // Raw Output & Metadata
  rawJson             Json? // Full inference payload from AI provider
  modelId             String?
  modelVersion        String?
  inferenceMs         Int? // latency
  clinicalContext     String? // FHIR context used for multimodal inference
  longitudinalContext String? // Prior scan comparison context

  // Validation (Feature 3/4)
  validationStatus      String? // CONFIRMED | REJECTED | AMBIGUOUS
  humanCorrectedFinding String? // Correction from a human specialist
  validationComments    String? // Notes from the validator
  validatedBy           String? // User ID of the validator
  validatedAt           DateTime? // When it was validated

  // A/B test tracking (Feature 7)
  abTestGroup String?
  abModelId   String?

  // Clinical performance tracking
  isFalsePositive Boolean?
  isFalseNegative Boolean?
  fROCPoint       Float? // Calibration point on Free-response ROC
  calibrationId   String? // link to calibration cohort

  createdAt DateTime @default(now())

  @@index([urgency])
  @@index([scanId])
}

// ── REPORTS ───────────────────────────────────────────────────
model Report {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  scanId     String          @unique
  scan       Scan            @relation(fields: [scanId], references: [id])
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  templateId String?
  template   ReportTemplate? @relation(fields: [templateId], references: [id])

  // Content
  technique      String?
  findings       String
  impression     String
  recommendation String?
  fullText       String? // full structured report
  content        String? // legacy content field
  summary        String? // legacy summary field

  // Status
  status   String    @default("draft") // draft | pending_review | approved | rejected | signed
  signedAt DateTime?
  signedBy String?

  // VLM generation metadata (Feature 3)
  vlmGenerated  Boolean @default(false)
  vlmVersion    String?
  vlmPrompt     String?
  editedByHuman Boolean @default(false)

  // FHIR output
  fhirDiagnosticReportId String?
  hl7OruMessageId        String?

  // Blockchain audit (Feature 19)
  blockchainHash String?
  blockchainTxId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pdfUrl String? // URL to the generated clinical PDF/HTML report

  secondOpinions SecondOpinion[]
  versions       ReportVersion[]

  @@index([tenantId])
  @@index([status])
}

// ── FEDERATED LEARNING V2 ─────────────────────────────────────────────

model FederatedWeightUpload {
  id               String   @id @default(uuid())
  nodeId           String
  roundId          String
  weightsHash      String
  weightsBlobUrl   String?
  sampleCount      Int
  localLoss        Float?
  localAccuracy    Float?
  gradientNorm     Float?
  dpEpsilonUsed    Float
  dpDelta          Float   @default(0.00001)
  clipNorm         Float   @default(1.0)
  signatureValid   Boolean @default(false)
  accepted         Boolean @default(false)
  rejectionReason  String?
  uploadedAt       DateTime @default(now())
  processedAt      DateTime?

  @@index([nodeId])
  @@index([roundId])
  @@index([uploadedAt])
}

model FederatedModelVersion {
  id                 String   @id @default(uuid())
  version            String   @unique
  roundId            String?
  weightsBlobUrl     String
  weightsHash        String
  accuracy           Float?
  loss               Float?
  participatingNodes String[]
  totalDataVolume    Int
  globalEpsilon      Float?
  status             String   @default("production")
  deployedAt         DateTime @default(now())
  rolledBackAt       DateTime?
  rollbackReason     String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([version])
  @@index([status])
}

model FederatedTrustAudit {
  id               String   @id @default(uuid())
  nodeId           String
  event            String
  previousScore    Float?
  newScore         Float?
  reason           String   @db.Text
  triggeredBy      String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([nodeId])
  @@index([event])
  @@index([createdAt])
}

model FLBenchmark {
  id                 String   @id @default(uuid())
  roundId            String
  nodeId             String
  tenantId           String
  localAccuracy      Float
  localF1            Float?
  localAuroc         Float?
  localPrecision     Float?
  localRecall        Float?
  inferenceLatencyMs Int?
  samplesUsed        Int
  modalityBreakdown  Json?
  accuracyDelta      Float?
  rankAmongNodes     Int?
  createdAt          DateTime @default(now())

  @@index([roundId])
  @@index([nodeId])
  @@index([tenantId])
}

// ── ACI FEEDBACK (Ambient Clinical Intelligence loop) ────────
model ACIFeedback {
  id            String   @id @default(uuid())
  scanId        String
  userId        String
  tenantId      String
  
  originalText  String   @db.Text
  correctedText String   @db.Text
  source        String   // e.g. VOICE_DICTATION, VLM_PREFILL
  
  createdAt     DateTime @default(now())

  @@index([scanId])
  @@index([tenantId])
}

// ── REPORT TEMPLATES (Feature 11) ─────────────────────────────
model ReportTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  specialty String // radiology | neuro | cardio | msk | etc
  modality  String?
  bodyPart  String?
  structure Json // template sections with placeholders
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@index([tenantId, specialty])
}

// ── IMAGE ANNOTATIONS (Feature 12) ────────────────────────────
model Annotation {
  id        String   @id @default(uuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id])
  userId    String
  type      String // rectangle | ellipse | polygon | freehand | arrow
  data      Json // coordinates, measurements
  label     String?
  color     String   @default("#FFD700")
  createdAt DateTime @default(now())

  @@index([scanId])
}

// ── SECOND OPINIONS (Feature 13) ──────────────────────────────
model SecondOpinion {
  id           String   @id @default(uuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id])
  reportId     String?
  report       Report?  @relation(fields: [reportId], references: [id])
  requesterId  String
  requester    User     @relation("Requester", fields: [requesterId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("AssignedSpecialist", fields: [assignedToId], references: [id])
  status       String   @default("pending") // pending | assigned | completed | disagreement | cancelled
  priority     String   @default("ROUTINE") // STAT | URGENT | ROUTINE
  reason       String?  @db.Text
  notes        String?  @db.Text
  reviewNotes  String?  @db.Text
  agreedWithAI Boolean?

  // Billing & Payment
  billingType   String   @default("hospital") // hospital | patient
  paymentStatus String   @default("unpaid")   // unpaid | paid | refunded
  paymentLinkId String?

  // SLA & Workflow
  slaDeadline DateTime?
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scanId])
  @@index([status])
  @@index([priority])
  @@index([requesterId])
  @@index([assignedToId])
}

// ── NOTIFICATIONS (Feature 6) ─────────────────────────────────
model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String // critical_finding | report_ready | second_opinion | payment | system
  title      String
  message    String
  body       String
  data       Json?
  read       Boolean  @default(false)
  fcmSent    Boolean  @default(false)
  tenantId   String
  scanId     String?
  aiResultId String?
  channels   String[] @default([])
  createdAt  DateTime @default(now())

  @@index([userId, read])
}

// ── PAYMENTS (Feature 5) ──────────────────────────────────────
model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  type       String // subscription | per_scan | one_time
  provider   String // stripe | paystack | flutterwave | mpesa
  externalId String? // Stripe PaymentIntent ID, Paystack reference, etc
  amount     Float
  currency   String
  status     String // pending | succeeded | failed | refunded
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([provider])
}

// ── CONTINUOUS LEARNING: CORRECTIONS (Feature 7) ──────────────
model Correction {
  id              String   @id @default(uuid())
  scanId          String
  tenantId        String
  radiologistId   String
  aiFinding       String
  aiUrgency       String
  aiConfidence    Float
  humanFinding    String
  humanUrgency    String
  correctionType  String   // finding_changed | urgency_downgraded | urgency_upgraded | false_positive | false_negative | confidence_wrong
  modality        String   // CT | MRI | XR | US | MG
  bodyPart        String
  groundTruthLabel Int?
  notes           String?
  isCriticalMiss  Boolean  @default(false)
  modelVersion    String?  // AI model version that produced the prediction
  trainingUsed    Boolean  @default(false) // whether this correction was used in a training run
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([scanId])
  @@index([correctionType])
  @@index([trainingUsed])
  @@map("corrections")
}

// ── CONTINUOUS LEARNING: TRAINING RUNS ─────────────────────────
model TrainingRun {
  id              String   @id @default(uuid())
  modelType       String   // triage | uncertainty | vlm | metacognition
  baseVersion     String   // e.g. "v2.4.1"
  targetVersion   String   // e.g. "v2.4.2"
  status          String   @default("pending") // pending | preparing | training | validating | deploying | completed | failed | rolled_back
  trainingSamples Int      @default(0)
  epochs          Int      @default(10)
  batchSize       Int      @default(32)
  learningRate    Float    @default(0.0001)
  findingDistribution Json? // distribution of findings in training set
  correctionTypes Json?    // breakdown of correction types used
  tenantIds       String[] // tenants whose corrections were used
  accuracy        Float?
  precision       Float?
  recall          Float?
  f1Score         Float?
  loss            Float?
  modelPath       String?  // path to trained model artifact in blob storage
  triggeredBy     String   // "auto_drift" | "auto_threshold" | "manual" | "federated"
  driftSnapshot   Json?    // drift metrics at trigger time
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  rollbackAt      DateTime?
  rollbackReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([modelType, status])
  @@index([status])
  @@index([createdAt])
  @@map("training_runs")
}

// ── CONTINUOUS LEARNING: FEATURE DRIFT SNAPSHOT ────────────────
model FeatureDriftSnapshot {
  id              String   @id @default(uuid())
  modelType       String   // triage | uncertainty | vlm | metacognition
  modelVersion    String
  baselineWindow  DateTime // start of baseline period
  currentWindow   DateTime // start of current period
  psi             Float    // Population Stability Index across all features
  kappa           Float    // Cohen's Kappa
  featureDists    Json?    // per-feature distribution comparison
  modalityShift   Json?    // modality distribution change
  bodyPartShift   Json?    // body part distribution change
  severityShift   Json?    // urgency distribution change
  driftDetected   Boolean  @default(false)
  severity        String   @default("none") // none | low | medium | high | critical
  createdAt       DateTime @default(now())

  @@index([modelType, modelVersion, driftDetected])
  @@index([createdAt])
  @@map("feature_drift_snapshots")
}

// ── AI MODEL REGISTRY (Feature 7, 18) ─────────────────────────
model AIModel {
  id         String   @id @default(uuid())
  name       String
  version    String
  type       String // triage | uncertainty | metacognition | vlm
  status     String   @default("production") // production | ab_test | training | deprecated
  accuracy   Float?
  trafficPct Float    @default(100) // % of traffic for A/B testing
  conditions String[] // conditions it detects
  modelPath  String? // path in Azure ML / S3
  isGlobal   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenantModels TenantAIModel[]
}

model TenantAIModel {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  modelId    String
  model      AIModel  @relation(fields: [modelId], references: [id])
  trafficPct Float    @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([tenantId, modelId])
}

// ── AUDIT LOG — HIPAA/GDPR Compliant (Feature 19) ────────────
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String // LOGIN | LOGOUT | SCAN_UPLOAD | REPORT_SIGNED | etc
  entity       String? // Scan | AIResult | Report | Notification | User
  entityId     String?
  previousHash String? // SHA-256 of previous audit record (Merkle chain)
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  // Blockchain (Feature 19)
  sha256Hash   String?
  blockIndex   Int?
  merkleRoot   String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityId])
  @@index([createdAt])
}

// ── MESSAGES (Feature 8 — Patient Portal) ────────────────────
model Message {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  fromUserId String?
  fromRole   String // doctor | radiologist | system | patient
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([patientId])
}

// ── USER NOTIFICATION & WHATSAPP FIELDS (migration adds to User) ─
// Add these fields to the User model above via migration:
// whatsappNumber    String?
// whatsappVerified  Boolean  @default(false)
// fcmTokens         String[] @default([])
// notifPrefs        Json?    // { push:bool, email:bool, whatsapp:bool, sms:bool }

// ── APPOINTMENTS ──────────────────────────────────────────────
model Appointment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String
  // doctor     User      (resolved via userId lookup — no Prisma relation to avoid multi-relation)

  scanId   String? // optional — pre-scan appointment
  reportId String? // optional — post-report follow-up

  type     String // consultation | follow_up | imaging | telemedicine | second_opinion
  status   String @default("scheduled") // scheduled | confirmed | cancelled | completed | no_show | rescheduled
  priority String @default("routine") // routine | urgent | stat

  scheduledDate DateTime
  durationMins  Int      @default(30)
  location      String? // room / video URL
  notes         String?
  cancelReason  String?
  cancelledById String?

  // Reminders
  reminderSent24h Boolean @default(false)
  reminderSent1h  Boolean @default(false)

  // Telehealth
  videoUrl    String?
  videoRoomId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledDate])
  @@index([status])
}

// ── NOTIFICATION PREFERENCES ──────────────────────────────────
model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  // Channels
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  // Per-event overrides stored as JSON: { "critical_finding": { push:true, email:true } }
  eventOverrides  Json?
  // Quiet hours (UTC)
  quietStart      String? // "22:00"
  quietEnd        String? // "07:00"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── WHATSAPP REGISTRATIONS ─────────────────────────────────────
model WhatsAppRegistration {
  id           String    @id @default(uuid())
  userId       String    @unique
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  number       String // E.164 e.g. +447911123456
  verified     Boolean   @default(false)
  verifyCode   String?
  verifyExpiry DateTime?
  optedIn      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([number])
}

// ── NOTIFICATION LOG (delivery tracking) ──────────────────────
model NotificationLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  channel   String // push | email | whatsapp | socket
  status    String // sent | failed | bounced | delivered
  metadata  Json? // FCM message ID, email message ID, WhatsApp SID
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([channel, status])
}

// ── CLINICAL VALIDATION (Feature 13) ──────────────────────────
model ClinicalValidation {
  id            String   @id @default(uuid())
  scanId        String   @unique
  scan          Scan     @relation(fields: [scanId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("pending") // pending | agreed | disagreed | uncertain
  aiConfidence  Float
  humanNotes    String?
  findingsMatch Boolean?
  createdAt     DateTime @default(now())

  @@index([scanId])
  @@index([status])
}

// ── DICOM NODES & CONNECTIVITY (Feature 4) ────────────────────
model DicomNode {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  aeTitle   String
  ipAddress String
  port      Int      @default(11112)
  status    String   @default("online")
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ── REGULATORY AUDIT & COMPLIANCE (Feature 19) ────────────────
model ComplianceRecord {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  standard     String // GDPR | HIPAA | NHS_DSPT | CE_MARK | FDA_510K
  status       String // compliant | gap_detected | in_remediation
  evidenceUrls String[]
  lastAuditAt  DateTime @default(now())
  nextAuditAt  DateTime
  createdAt    DateTime @default(now())

  @@index([tenantId, standard])
}

// ── DUNNING LOG (Failed Payment Recovery) ─────────────────────
model DunningLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  step      Int // 1, 2, 3 — which dunning step this is
  sentAt    DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([step])
}

// ── SUPPORT TICKETS (Customer Support Integration) ────────────────────
model SupportTicket {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  description String
  category    String // billing | technical | clinical | general | feature_request
  priority    String // low | medium | high | urgent
  status      String   @default("open") // open | in_progress | waiting_on_customer | resolved | closed
  zendeskId   String? // External ticket ID if using Zendesk
  assignedTo  String? // User ID of support agent assigned
  tags        String[]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ── MODEL PERFORMANCE MONITORING (Post-Market Surveillance) ────────────
model AIModelVersion {
  id                      String                   @id @default(uuid())
  modelType               String // triage | uncertainty | vlm | metacognition
  version                 String // e.g., "2.4.1"
  description             String? // release notes/what changed
  region                  String? // uk | eu | us | africa | india
  active                  Boolean                  @default(true)
  deployedAt              DateTime                 @default(now())
  metadata                Json? // model weights hash, hyperparams, etc.
  modelPerformanceMetrics ModelPerformanceMetric[]
  aiDriftEvents           AIDriftEvent[]

  @@index([modelType])
  @@index([region])
  @@index([active])
}

model ModelPerformanceMetric {
  id             String         @id @default(uuid())
  modelVersionId String?
  modelVersion   AIModelVersion? @relation(fields: [modelVersionId], references: [id])
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  scanId         String?
  scan           Scan?          @relation(fields: [scanId], references: [id])
  modality       String
  condition      String?
  metricType     String // accuracy | precision | recall | specificity | f1 | auroc | kappa | psi // psi=population stability index (drift)
  value          Decimal
  sampleSize     Int?
  windowStart    DateTime?
  windowEnd      DateTime?
  createdAt      DateTime       @default(now())

  @@index([modelVersionId])
  @@index([tenantId])
  @@index([modality])
  @@index([createdAt])
}

model AIDriftEvent {
  id             String         @id @default(uuid())
  modelVersionId String
  modelVersion   AIModelVersion @relation(fields: [modelVersionId], references: [id])
  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  driftType      String // data | concept | prediction
  severity       String // low | medium | high | critical
  description    String
  detectedAt     DateTime       @default(now())
  resolvedAt     DateTime?
  status         String         @default("detected") // detected | investigating | mitigated | resolved
  metadata       Json?

  @@index([modelVersionId])
  @@index([tenantId])
  @@index([status])
}

// ── CUSTOMER FEEDBACK LOOP ───────────────────────────────────────────
model CustomerFeedback {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  feedbackType String // feature_request | bug_report | satisfaction | usability | general
  score        Int? // 1-5 for satisfaction ratings
  subject      String?
  description  String
  category     String? // e.g., "radiologist_ui", "ai_accuracy", "mobile_app"
  metadata     Json? // associated scanId, reportId, etc.
  status       String   @default("new") // new | reviewed | in_progress | actioned | closed
  prioritized  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, id], name: "tenantId_id")
  @@index([tenantId])
  @@index([userId])
  @@index([feedbackType])
  @@index([status])
  @@index([createdAt])
}

// ── FEDERATED LEARNING ───────────────────────────────────────────────
model FederatedNode {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  status                String   @default("active") // active | offline | syncing
  totalScansContributed Int      @default(0)
  computeCapacity       String   @default("medium") // low | medium | high
  lastSyncAt            DateTime @default(now())
  nodePublicKey         String?
  nodeEndpoint          String?
  trustScore            Float    @default(50)
  trustFactors          Json?
  dpBudgetTotal         Float    @default(10.0)
  dpBudgetUsed          Float    @default(0)
  dpBudgetResetAt       DateTime?
  roundsParticipated    Int      @default(0)
  roundsMissed          Int      @default(0)
  lastWeightsHash       String?
  avgGradientNorm       Float?
  quarantineReason      String?
  quarantinedAt         DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model FederatedRound {
  id                    String   @id @default(uuid())
  roundNumber           Int      @unique
  status                String   @default("in_progress") // pending | in_progress | completed | failed
  participatingNodes    Int      @default(0)
  totalDataVolume       Int      @default(0) // total scans used in this round
  epochLoss             Float?
  accuracy              Float?
  aggregatedModelVersion String?
  globalEpsilon         Float?
  avgTrustScore         Float?
  minTrustThreshold     Float   @default(60)
  dpNoiseMultiplier     Float?
  weightsSnapshotsUrl   String?
  failedNodeIds         String[]
  rejectedUploads       Int     @default(0)
  durationMs            Int?
  aggregatedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mlValidations       MlModelValidation[]

  @@index([status])
}

// ── EDGE AI (OFFLINE SYNC) ─────────────────────────────────────────
model EdgeDevice {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  deviceId        String   @unique // Hardware serial or MAC
  deviceName      String   @default("Mobile Clinic Tablet")
  status          String   @default("offline") // online | offline | syncing
  lastHeartbeat   DateTime @default(now())
  storageUsedMB   Int      @default(0)
  totalSyncedScans Int     @default(0)
  region          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncLogs        EdgeSyncLog[]

  @@index([tenantId])
  @@index([status])
}

model EdgeSyncLog {
  id               String      @id @default(uuid())
  edgeDeviceId     String
  edgeDevice       EdgeDevice  @relation(fields: [edgeDeviceId], references: [id])
  scansUploaded    Int         @default(0)
  bytesTransferred Int         @default(0)
  syncDurationSec  Int         @default(0)
  status           String      @default("success") // success | failed | partial
  createdAt        DateTime    @default(now())

  @@index([edgeDeviceId])
}

// ── POPULATION HEALTH & EPIDEMIOLOGY ────────────────────────────────
model EpidemiologyEvent {
  id              String   @id @default(uuid())
  disease         String   // e.g., Tuberculosis, Pneumonia, ICH, Stroke
  region          String   // e.g., UK, NG, KE
  subRegion       String?  // e.g., Lagos, Nairobi, London
  severity        String   // High, Medium, Low
  confidenceScore Float    // AI confidence
  scanOrigin      String   @default("cloud") // edge vs cloud
  detectedAt      DateTime @default(now())

  @@index([disease, region])
  @@index([detectedAt])
}

// ── LONGITUDINAL PATIENT TRACKING ─────────────────────────────
model LongitudinalRecord {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  scanId          String
  scan            Scan     @relation(fields: [scanId], references: [id])
  
  recordedAt      DateTime @default(now())
  
  // Progression metrics (RECIST 1.1 equivalent)
  tumorVolumeCm3  Float?
  longestDiameterMm Float?
  progressionPct  Float? // Compared to previous baseline scan
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
  @@index([patientId])
  @@index([scanId])
}

// ── EDGE AI PRE-PROCESSING ─────────────────────────────────────────────

model EdgePreProcessing {
  id                    String   @id @default(uuid())
  scanId                String   @unique
  scan                  Scan     @relation(fields: [scanId], references: [id])
  edgeDeviceId          String
  siteId                String

  qualityScore          Float?
  qualityFlags          String[]
  blurScore             Float?
  noiseEstimate         Float?
  motionArtifact        Boolean  @default(false)

  urgencyHint           String?
  urgencyConfidence     Float?
  urgencyMethod         String?

  anonymizationVersion  String?
  anonymizationComplete Boolean  @default(false)
  phiStrippedTags       String[]

  metadataExtracted     Json?
  processingMs          Int?

  qualityModelVersion   String?
  triageModelVersion    String?
  edgeSoftwareVersion   String?

  offlineQueued         Boolean  @default(false)
  syncedAt              DateTime?

  createdAt             DateTime @default(now())

  @@index([edgeDeviceId])
  @@index([siteId])
  @@index([urgencyHint])
}

model EdgeSite {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  siteId                String   @unique
  siteName              String
  region                String   @default("uk")

  supportedModalities   String[] @default(["CT", "XR"])
  hasGpu                Boolean  @default(false)
  hasLocalRedis         Boolean  @default(false)

  enabledFeatures       String[] @default(["quality_assessment", "anonymization"])
  maxOfflineQueueSizeMB Int      @default(5000)
  heartbeatIntervalSec  Int      @default(30)

  status                String   @default("active")
  lastHeartbeat         DateTime @default(now())
  totalDevices          Int      @default(0)
  totalScansProcessed   Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ── META COGNITION / SELF-AUDIT LAYER ───────────────────────────────────

model MetacognitionAuditLog {
  id                             String   @id @default(uuid())
  scanId                         String
  tenantId                       String
  aiResultId                     String

  layer1ModalityPlausibility     String
  layer1Detail                   Json?
  layer2UrgencyConsistency       String
  layer2Detail                   Json?
  layer3ConfidenceFloor          String
  layer3Detail                   Json?
  layer4SHAPCoherence            String
  layer5UncertaintyConflict      String
  layer6ReportConcordance        String
  layer7DemographicPlausibility  String
  layer8HallucinationRisk        Float
  layer9SafeToAlert              Boolean

  contradictionDetected          Boolean  @default(false)
  contradictionType              String?
  contradictionSeverity          String?
  contradictionDetail            Json?
  vlmSemanticSimilarity          Float?

  clinicalRulesPassed            Int      @default(0)
  clinicalRulesFailed            Int      @default(0)
  clinicalRuleViolations         Json?

  brierScore                     Float?
  calibrationBin                 String?

  explainabilityReportUrl        String?
  reasoningChain                 Json?

  overallDecision                String
  decisionConfidence             Float
  decisionReasoning              String   @db.Text

  createdAt                      DateTime @default(now())

  @@index([scanId])
  @@index([tenantId])
  @@index([overallDecision])
  @@index([contradictionDetected])
  @@index([createdAt])
}

model CalibrationRecord {
  id                 String   @id @default(uuid())
  tenantId           String?
  modality           String?
  modelVersion       String?
  predictedConfidence Float
  actualOutcome      Boolean
  confidenceBin      String
  scanId             String?
  aiResultId         String?
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([modality])
  @@index([confidenceBin])
  @@index([createdAt])
}

model CalibrationSummary {
  id               String   @id @default(uuid())
  tenantId         String?
  modality         String?
  modelVersion     String?
  windowStart      DateTime
  windowEnd        DateTime
  sampleCount      Int
  eceBin02         Float?
  eceBin24         Float?
  eceBin46         Float?
  eceBin68         Float?
  eceBin810        Float?
  eceOverall       Float
  brierScore       Float
  eceTrend         String?
  driftDetected    Boolean  @default(false)
  driftAction      String?
  createdAt        DateTime @default(now())

  @@index([tenantId, modality])
  @@index([windowStart])
}

model ExplainabilityReport {
  id               String   @id @default(uuid())
  scanId           String   @unique
  tenantId         String
  aiResultId       String
  reasoningSteps   Json
  shapNarrative    String?  @db.Text
  gradCamRegions   Json?
  summaryText      String   @db.Text
  contradictionText String? @db.Text
  reportBlobUrl    String?
  reportFormat     String   @default("json")
  createdAt        DateTime @default(now())

  @@index([scanId])
  @@index([tenantId])
}

// ── REPORT VERSIONS (Audit trail for every report edit) ──────
model ReportVersion {
  id            String   @id @default(uuid())
  reportId      String
  report        Report   @relation(fields: [reportId], references: [id])
  version       Int
  technique     String?
  findings      String
  impression    String
  recommendation String?
  fullText      String?
  editedBy      String
  changeNote    String?
  sha256Hash    String
  createdAt     DateTime @default(now())

  @@unique([reportId, version])
  @@index([reportId])
  @@index([createdAt])
}

// ── AUDIT BLOCKS (Merkle tree batching for Confidential Ledger) ─
model AuditBlock {
  id                String   @id @default(uuid())
  blockIndex        Int      @unique
  merkleRoot        String
  entryCount        Int
  entryIds          String[] // ordered list of AuditLog IDs in this block
  previousBlockHash String?
  blockHash         String
  committed         Boolean  @default(false)
  ledgerTxId        String?
  ledgerReceipt     Json?
  createdAt         DateTime @default(now())

  @@index([blockIndex])
  @@index([committed])
}

// ── MLOPS: MODEL VALIDATION & DEPLOYMENT PIPELINE ──────────────
model MlModelValidation {
  id                  String   @id @default(uuid())
  federatedRoundId    String?
  federatedRound      FederatedRound? @relation(fields: [federatedRoundId], references: [id])
  modelType           String   // triage | uncertainty | vlm | metacognition
  modelVersion        String
  previousVersion     String?
  validationDataset   String   // internal | holdout | clinical
  accuracy            Float?
  precision           Float?
  recall              Float?
  f1Score             Float?
  auroc               Float?
  loss                Float?
  sampleSize          Int
  passed              Boolean  @default(false)
  metricsJson         Json?
  validatedBy         String?  // user ID or 'automated'
  validatedAt         DateTime @default(now())
  ocrImageUrl         String?  // screenshot of validation report
  createdAt           DateTime @default(now())

  deploymentTrigger   MlDeploymentTrigger?

  @@index([federatedRoundId])
  @@index([modelType, modelVersion])
  @@index([passed])
}

model MlDeploymentTrigger {
  id              String   @id @default(uuid())
  validationId    String   @unique
  validation      MlModelValidation @relation(fields: [validationId], references: [id])
  modelType       String
  modelVersion    String
  sourceImage     String   // ACR image URL to deploy
  targetService   String   // k8s deployment name
  status          String   @default("pending") // pending | deploying | deployed | failed | rolled_back
  triggerMetadata Json?
  startedAt       DateTime?
  completedAt     DateTime?
  rollbackAt      DateTime?
  rollbackReason  String?
  k8sJobName      String?
  k8sJobNamespace String   @default("sewa-ai")
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([modelType])
}

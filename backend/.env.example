# SEWA AI — backend/.env.example
# ─────────────────────────────────────────────────────────────────
# There are now two ready-made .env files:
#
#   .env.local  → local development (docker-compose postgres + redis)
#   .env.azure  → Azure production  (auto-filled by generate-env-azure.sh)
#
# ── QUICK START ────────────────────────────────────────────────
#
# Local development:
#   cp backend/.env.local backend/.env
#   docker-compose up -d
#   cd backend && npx prisma migrate dev && npm run dev
#
# Azure deployment:
#   cd infrastructure/terraform-azure
#   cp terraform.tfvars.example terraform.tfvars    # fill in 🔑 secrets
#   bash ../../scripts/bootstrap-tfstate.sh         # first time only
#   terraform init && terraform apply
#   bash ../../scripts/generate-env-azure.sh        # auto-build .env.azure
#   cp backend/.env.azure backend/.env
#   bash scripts/deploy-azure.sh
#
# ── SWITCHING BETWEEN LOCAL ↔ AZURE ───────────────────────────
#
#   To Azure:   cp backend/.env.azure backend/.env
#   To Local:   cp backend/.env.local backend/.env
#
# The DEPLOY_TARGET variable in .env controls behaviour:
#   DEPLOY_TARGET=local   → uses docker-compose services
#   DEPLOY_TARGET=azure   → uses Azure managed services
#
# ─────────────────────────────────────────────────────────────────
# This file is intentionally minimal — see .env.local or .env.azure
# for the full variable reference with documentation.
# ─────────────────────────────────────────────────────────────────

DEPLOY_TARGET=local

DATABASE_URL=postgresql://sewa:password@localhost:5432/sewa_ai
REDIS_URL=redis://:password@localhost:6379/0

JWT_SECRET=change_me_minimum_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_minimum_32_chars
ENCRYPTION_KEY=change_me_exactly_32_characters!!
